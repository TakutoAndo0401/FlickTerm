{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlickTerm",
  "version": "0.2.2",
  "identifier": "com.flickterm.app",
  "build": {
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "FlickTerm",
        "label": "main",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 420,
        "backgroundColor": "#111315"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "targets": ["app"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5RjY5MTM5QTM3OENCNDYKUldSR3kzaWpPWkgyNmFjSGxKRVNqd1NoWmJqTVVwV2JLWDZKNG5wZk5yU3hFZVRhTnlKalIyYUEK",
      "endpoints": [
        "https://github.com/TakutoAndo0401/FlickTerm/releases/latest/download/latest.json"
      ]
    }
  }
}
